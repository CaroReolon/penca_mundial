<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
      body { margin: 0; padding: 0; background: #f4f4f5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
      .wrapper { max-width: 480px; margin: 40px auto; background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.08); }
      .header { background: linear-gradient(135deg, #16a34a, #15803d); padding: 32px 24px; text-align: center; }
      .header h1 { margin: 0; color: #fff; font-size: 24px; font-weight: 800; letter-spacing: -0.5px; }
      .header p { margin: 4px 0 0; color: #bbf7d0; font-size: 13px; letter-spacing: 2px; text-transform: uppercase; }
      .body { padding: 32px 28px; }
      .body p { margin: 0 0 16px; color: #374151; font-size: 15px; line-height: 1.6; }
      .btn { display: block; margin: 24px 0; background: #16a34a; color: #fff !important; text-decoration: none; text-align: center; padding: 14px 24px; border-radius: 10px; font-size: 15px; font-weight: 700; }
      .token-box { background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 12px 16px; font-family: monospace; font-size: 13px; color: #111827; word-break: break-all; margin: 16px 0; }
      .footer { padding: 16px 28px 24px; text-align: center; font-size: 12px; color: #9ca3af; }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="header">
        <h1>⚽ Penca Mundial</h1>
        <p>FIFA World Cup 2026</p>
      </div>

      <div class="body">
        <p>Hi <%= @user.first_name %>,</p>
        <p>We received a request to reset your password. Click the button below to choose a new one:</p>

        <a href="<%= @reset_url %>" class="btn">Reset my password</a>

        <p style="font-size:13px; color:#6b7280;">Or paste this link in your browser:</p>
        <div class="token-box"><%= @reset_url %></div>

        <p style="font-size:13px; color:#6b7280; margin-top:24px;">
          If you didn't request this, just ignore this email — your password won't change.<br>
          This link expires in <strong>6 hours</strong>.
        </p>
      </div>

      <div class="footer">
        Penca Mundial &mdash; FIFA World Cup 2026
      </div>
    </div>
  </body>
</html>
